{
  "name": "vx-components",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/library/index.cjs",
  "module": "./dist/library/index.js",
  "types": "./dist/library/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library/types/index.d.ts",
      "import": "./dist/library/index.js",
      "require": "./dist/library/index.cjs"
    }
  },
  "files": [
    "dist/library"
  ],
  "web-types": [
    "./vx-webtypes.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:library && npm run build:standalone",
    "build:library": "vite build --mode library && tsc -p tsconfig.build.json && node scripts/rewrite-type-imports.mjs",
    "build:standalone": "vite build --mode standalone",
    "preview": "vite preview",
    "webtypes": "wca-webtypes analyse src/components/**/*.component.ts --format webtypes --outFile vx-webtypes.json"
  },
  "dependencies": {
    "color2k": "^2.0.4",
    "lit": "^3.3.3",
    "path-to-regexp": "^9.0.0"
  },
  "devDependencies": {
    "@web-types/lit": "^2.0.0-3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "wca": {
    "webtypesConfig": {
      "name": "vx-components",
      "version": "0.0.1",
      "framework": "lit",
      "description-markup": "markdown"
    }
  }
}
